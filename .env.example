# FRONTEND. These VITE_* values are embedded in the browser bundle and must be public.
VITE_API_BASE_URL=http://localhost:3001
VITE_GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID
VITE_TURNSTILE_SITE_KEY=REPLACE_WITH_TURNSTILE_PUBLIC_SITE_KEY

# Used only by the local admin prototype when the API is not configured.
VITE_RECRUITMENT_SHEET_URL=
