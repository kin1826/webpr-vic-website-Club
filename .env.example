# Google Apps Script Web App URL ending in /exec (public identifier, not a secret)
VITE_RECRUITMENT_API_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec

# Google OAuth Web Client ID used for admin sign-in (public OAuth identifier)
VITE_GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# Convenience link shown to authorized admins
VITE_RECRUITMENT_SHEET_URL=https://docs.google.com/spreadsheets/d/1CQiNWk2YZxKLlXA3asiB6K6ADqJSWwIFEymM156ol-A/edit

# Optional Cloudflare Turnstile public site key. Configure its secret only in Apps Script.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA-example-public-site-key
